<Window x:Class="AirTether.Views.CustomTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="自定义网络制式文本"
        Icon="pack://application:,,,/Assets/AirTether.ico"
        Width="320"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#F01F1F1F"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.55" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <TextBlock Text="自定义托盘网络文本"
                       Foreground="White"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="15"
                       FontWeight="SemiBold"/>
            <TextBlock Text="输入要显示在 4G/5G 图标上的文本（留空则自动跟随手机网络制式）"
                       Foreground="#AAFFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,6,0,12"/>

            <TextBox x:Name="TbCustomText"
                     Background="#2B2B2B"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#55FFFFFF"
                     BorderThickness="1"
                     Padding="8,6"
                     FontFamily="Segoe UI, Microsoft YaHei UI"
                     FontSize="14"
                     MaxLength="8"
                     Margin="0,0,0,14"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnReset"
                        Grid.Column="0"
                        Content="恢复自动"
                        Click="BtnReset_Click"
                        Background="#2E2E2E"
                        Foreground="#E6FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="10,6"
                        Cursor="Hand"/>

                <Button x:Name="BtnCancel"
                        Grid.Column="2"
                        Content="取消"
                        Click="BtnCancel_Click"
                        Background="#2E2E2E"
                        Foreground="#E6FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="14,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Button x:Name="BtnSave"
                        Grid.Column="3"
                        Content="确定"
                        IsDefault="True"
                        Click="BtnSave_Click"
                        Background="#0078D7"
                        Foreground="White"
                        BorderBrush="#0078D7"
                        BorderThickness="1"
                        Padding="14,6"
                        Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
