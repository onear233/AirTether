<Window x:Class="AirTether.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirTether 设置"
        Icon="pack://application:,,,/Assets/AirTether.ico"
        Width="360"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#F21F1F1F"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Title Row -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="AirTether 设置"
                           Foreground="White"
                           FontFamily="Segoe UI, Microsoft YaHei UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="v1.0.1"
                           Foreground="#77FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Section 1: Bluetooth & Hotspot Auto Connect -->
            <TextBlock Text="连接与热点协同"
                       Foreground="#CCFFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkAutoReconnect"
                      Content="自动重连上次的设备"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="13"
                      Margin="0,0,0,10"/>

            <CheckBox x:Name="ChkAutoConnectWifi"
                      Content="打开热点后电脑自动连接热点"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="13"
                      Margin="0,0,0,12"/>

            <TextBlock Text="指定热点 Wi-Fi 名称（留空则自动使用手机上报的 SSID）"
                       Foreground="#99FFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>

            <TextBox x:Name="TbFallbackSsid"
                     Background="#2B2B2B"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#44FFFFFF"
                     BorderThickness="1"
                     Padding="8,6"
                     FontFamily="Segoe UI, Microsoft YaHei UI"
                     FontSize="13"
                     MaxLength="32"
                     Margin="0,0,0,18"/>

            <!-- Divider -->
            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,14"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel"
                        Grid.Column="1"
                        Content="取消"
                        Click="BtnCancel_Click"
                        Background="#2E2E2E"
                        Foreground="#E6FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        Content="保存"
                        IsDefault="True"
                        Click="BtnSave_Click"
                        Background="#0078D7"
                        Foreground="White"
                        BorderBrush="#0078D7"
                        BorderThickness="1"
                        Padding="18,6"
                        Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
