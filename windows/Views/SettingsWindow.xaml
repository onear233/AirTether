<Window x:Class="AirTether.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AirTether 设置"
        Icon="pack://application:,,,/Assets/AirTether.ico"
        Width="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ResizeMode="NoResize">

    <Border Background="#F21F1F1F"
            BorderBrush="#44FFFFFF"
            BorderThickness="1"
            Padding="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.6" Color="Black"/>
        </Border.Effect>

        <StackPanel>
            <!-- Title Row -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="AirTether 设置"
                           Foreground="White"
                           FontFamily="Segoe UI, Microsoft YaHei UI"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="v1.0.1"
                           Foreground="#77FFFFFF"
                           FontFamily="Segoe UI"
                           FontSize="12"
                           VerticalAlignment="Center"/>
            </Grid>

            <!-- Section 1: Bluetooth & Hotspot Auto Connect -->
            <TextBlock Text="连接与热点协同"
                       Foreground="#CCFFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkAutoReconnect"
                      Content="自动重连上次的设备"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="12.5"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkAutoConnectWifi"
                      Content="打开热点后电脑自动连接热点"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="12.5"
                      Margin="0,0,0,8"/>

            <TextBlock Text="指定热点 Wi-Fi 名称（留空则自动使用手机上报的 SSID）"
                       Foreground="#99FFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="11.5"
                       TextWrapping="Wrap"
                       Margin="0,0,0,5"/>

            <TextBox x:Name="TbFallbackSsid"
                     Background="#2B2B2B"
                     Foreground="White"
                     CaretBrush="White"
                     BorderBrush="#44FFFFFF"
                     BorderThickness="1"
                     Padding="8,5"
                     FontFamily="Segoe UI, Microsoft YaHei UI"
                     FontSize="12.5"
                     MaxLength="32"
                     Margin="0,0,0,14"/>

            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,12"/>

            <!-- Section 2: Notifications, Battery & Handoff -->
            <TextBlock Text="通知镜像、电量与接力"
                       Foreground="#CCFFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkNotifMirror"
                      Content="启用手机白名单通知镜像（支持桌面一键清除）"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="12.5"
                      Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkAutoOpenUrl"
                      Content="收到手机网页链接时自动用浏览器打开"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="12.5"
                      Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <CheckBox x:Name="ChkBatteryAlerts"
                          Grid.Column="0"
                          Content="低电量与充满电桌面提醒"
                          Foreground="#F0FFFFFF"
                          FontFamily="Segoe UI, Microsoft YaHei UI"
                          FontSize="12.5"
                          VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="低电阈值"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"/>

                <TextBox x:Name="TbLowBattery"
                         Grid.Column="2"
                         Background="#2B2B2B"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#44FFFFFF"
                         BorderThickness="1"
                         Padding="4,3"
                         TextAlignment="Center"
                         FontSize="12"/>

                <TextBlock Grid.Column="3"
                           Text="%"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </Grid>

            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,12"/>

            <!-- Section 3: Proximity Auto-Lock -->
            <TextBlock Text="离开自动锁屏（BLE 近场感应）"
                       Foreground="#CCFFFFFF"
                       FontFamily="Segoe UI, Microsoft YaHei UI"
                       FontSize="13"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <CheckBox x:Name="ChkProximityLock"
                      Content="手机远离或意外断连超时后自动锁屏"
                      Foreground="#F0FFFFFF"
                      FontFamily="Segoe UI, Microsoft YaHei UI"
                      FontSize="12.5"
                      Margin="0,0,0,8"/>

            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="56"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="48"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="信号阈值"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <TextBox x:Name="TbRssiThreshold"
                         Grid.Column="1"
                         Background="#2B2B2B"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#44FFFFFF"
                         BorderThickness="1"
                         Padding="4,3"
                         TextAlignment="Center"
                         FontSize="12"/>

                <TextBlock Grid.Column="2"
                           Text="dBm"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>

                <TextBlock Grid.Column="4"
                           Text="离开延迟"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="8,0,6,0"/>

                <TextBox x:Name="TbLockDelay"
                         Grid.Column="5"
                         Background="#2B2B2B"
                         Foreground="White"
                         CaretBrush="White"
                         BorderBrush="#44FFFFFF"
                         BorderThickness="1"
                         Padding="4,3"
                         TextAlignment="Center"
                         FontSize="12"/>

                <TextBlock Grid.Column="6"
                           Text="秒"
                           Foreground="#99FFFFFF"
                           FontSize="11.5"
                           VerticalAlignment="Center"
                           Margin="4,0,0,0"/>
            </Grid>

            <!-- Divider -->
            <Border Height="1" Background="#22FFFFFF" Margin="0,0,0,14"/>

            <!-- Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="BtnCancel"
                        Grid.Column="1"
                        Content="取消"
                        Click="BtnCancel_Click"
                        Background="#2E2E2E"
                        Foreground="#E6FFFFFF"
                        BorderBrush="#44FFFFFF"
                        BorderThickness="1"
                        Padding="16,6"
                        Margin="0,0,8,0"
                        Cursor="Hand"/>

                <Button x:Name="BtnSave"
                        Grid.Column="2"
                        Content="保存"
                        IsDefault="True"
                        Click="BtnSave_Click"
                        Background="#0078D7"
                        Foreground="White"
                        BorderBrush="#0078D7"
                        BorderThickness="1"
                        Padding="18,6"
                        Cursor="Hand"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
